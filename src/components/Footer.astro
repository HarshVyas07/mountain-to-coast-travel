---
// Footer with navigation to standalone pages, newsletter, destinations, direct contact & social media
---

<footer class="w-full bg-surface-container-low text-on-surface shadow-[0_-1px_12px_rgba(20,40,29,0.03)] border-t border-outline-variant/30">
  <div class="max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg pt-space-2xl pb-space-xl">

    <!-- Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-gutter-lg pb-space-2xl">

      <!-- Newsletter Column -->
      <div class="lg:col-span-4 flex flex-col gap-space-md">
        <div class="flex items-center gap-3">
          <img src="/assets/images/logo.png" alt="Mountains to Coast Travel" class="h-11 w-auto max-w-[120px] rounded-lg shadow-sm object-contain" />
          <div class="flex flex-col">
            <span class="font-headline-sm text-[17px] text-primary font-medium tracking-tight">Mountains to Coast</span>
            <span class="font-label-md text-[10px] uppercase text-secondary tracking-widest">Latin America</span>
          </div>
        </div>
        <span class="font-label-md text-label-md uppercase tracking-widest text-secondary font-semibold">The Dispatch</span>
        <h3 class="font-headline-md text-headline-md text-primary">
          Uncharted Latin America delivered softly to your inbox.
        </h3>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
          Upcoming tour dates, lodge openings, conservation dispatches, and seasonal travel tips from Michael and Maria.
        </p>
        <form class="flex flex-col sm:flex-row items-stretch gap-space-sm pt-space-sm max-w-md" onsubmit="event.preventDefault(); alert('Thank you for subscribing to The Dispatch!');">
          <input
            class="flex-1 bg-surface-container-lowest px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded placeholder:text-on-surface-variant/60 focus:outline-none focus:bg-surface-bright transition-colors border border-outline-variant/30"
            placeholder="Enter your email address"
            type="email"
            required
          />
          <button
            class="bg-primary text-on-primary px-space-lg py-space-sm rounded font-label-lg text-label-lg uppercase tracking-wider hover:bg-primary-container transition-all text-center cursor-pointer"
            type="submit"
          >
            Subscribe
          </button>
        </form>

        <!-- Social Media Follow Links -->
        <div class="pt-space-sm">
          <span class="font-label-md text-[11px] uppercase tracking-wider text-secondary font-bold block mb-2">Follow Our Expeditions:</span>
          <div class="flex items-center gap-3">
            <!-- Facebook -->
            <a
              href="https://www.facebook.com/share/1DtmuAkLDi/?mibextid=wwXIfr"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-surface-container-lowest border border-outline-variant/40 flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-all shadow-sm hover:scale-105"
              aria-label="Follow Mountains to Coast Travel on Facebook"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/>
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href="https://www.instagram.com/mountainstocoasttravel?dlrf=N3p1M3NoazNkZTYx&utm_source=qr"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-surface-container-lowest border border-outline-variant/40 flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-all shadow-sm hover:scale-105"
              aria-label="Follow Mountains to Coast Travel on Instagram"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- YouTube -->
            <a
              href="https://youtube.com/@mariapadillah?si=ex-xcToOotZvk__q"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-surface-container-lowest border border-outline-variant/40 flex items-center justify-center text-primary hover:bg-[#ff0000] hover:text-white transition-all shadow-sm hover:scale-105"
              aria-label="Follow Mountains to Coast Travel on YouTube"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <!-- TikTok -->
            <a
              href="https://www.tiktok.com/@mountaintocoasttravel?_r=1&_t=ZT-9AsityZTDQ5"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-surface-container-lowest border border-outline-variant/40 flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-all shadow-sm hover:scale-105"
              aria-label="Follow Mountains to Coast Travel on TikTok"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Navigation (Standalone Pages) -->
      <div class="lg:col-span-2 flex flex-col gap-space-sm">
        <h4 class="font-label-lg text-label-lg uppercase tracking-widest text-primary font-bold">Navigation</h4>
        <ul class="flex flex-col gap-space-xs font-body-md text-body-md text-on-surface-variant">
          <li><a href="/" class="hover:text-primary transition-colors">HOME</a></li>
          <li><a href="/tours" class="hover:text-primary transition-colors">Upcoming Tours</a></li>
          <li><a href="/about" class="hover:text-primary transition-colors">About Us</a></li>
          <li><a href="/gallery" class="hover:text-primary transition-colors">Gallery</a></li>
          <li><a href="/contact" class="hover:text-primary transition-colors">Contact</a></li>
          <li><a href="/terms" class="hover:text-primary transition-colors text-xs text-on-surface-variant/80">Terms &amp; Conditions</a></li>
          <li><a href="/privacy" class="hover:text-primary transition-colors text-xs text-on-surface-variant/80">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Destinations Links (Nicaragua confirmed; rest Date Not Planned) -->
      <div class="lg:col-span-3 flex flex-col gap-space-sm">
        <h4 class="font-label-lg text-label-lg uppercase tracking-widest text-primary font-bold">Latin America Guided Tours</h4>
        <ul class="flex flex-col gap-space-xs font-body-md text-body-md text-on-surface-variant">
          <li>
            <a href="/nicaragua" class="hover:text-primary transition-colors font-semibold text-primary flex items-center justify-between" title="Guided Tours of Nicaragua">
              <span>Guided Tours of Nicaragua</span>
              <span class="text-[10px] bg-primary text-on-primary px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">Feb 2027</span>
            </a>
          </li>
          <li>
            <a href="/costa-rica" class="hover:text-primary transition-colors flex items-center justify-between" title="Guided Tours of Costa Rica">
              <span>Guided Tours of Costa Rica</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Custom 5+</span>
            </a>
          </li>
          <li>
            <a href="/guatemala" class="hover:text-primary transition-colors flex items-center justify-between" title="Guided Tours of Guatemala">
              <span>Guided Tours of Guatemala</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Custom 5+</span>
            </a>
          </li>
          <li>
            <a href="/honduras" class="hover:text-primary transition-colors flex items-center justify-between" title="Guided Tours of Honduras">
              <span>Guided Tours of Honduras</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Custom 5+</span>
            </a>
          </li>
          <li>
            <a href="/el-salvador" class="hover:text-primary transition-colors flex items-center justify-between" title="Guided Tours of El Salvador">
              <span>Guided Tours of El Salvador</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Custom 5+</span>
            </a>
          </li>
          <li>
            <a href="/peru" class="hover:text-primary transition-colors flex items-center justify-between" title="Guided Tours of Peru">
              <span>Guided Tours of Peru</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Custom 5+</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Direct Contact & Guides Leadership Column -->
      <div class="lg:col-span-3 flex flex-col gap-space-md">
        <h4 class="font-label-lg text-label-lg uppercase tracking-widest text-primary font-bold">Best US Travel Guides</h4>
        <div class="flex flex-col gap-2 font-body-md text-body-md text-on-surface-variant">
          <a href="mailto:mheller@mountainstocoasttravel.com" class="hover:text-primary transition-colors flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-secondary">mail</span>
            <span class="text-xs font-semibold text-primary break-all">mheller@mountainstocoasttravel.com</span>
          </a>
          <a href="tel:+14437225210" class="hover:text-primary transition-colors flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-secondary">call</span>
            <span class="text-xs font-semibold text-primary">+1 (443) 722-5210</span>
          </a>
          <a href="https://wa.me/14437225210" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors flex items-center gap-2 text-xs text-secondary font-bold">
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>WhatsApp Direct Line</span>
          </a>
        </div>
        <p class="font-caption text-caption text-on-surface-variant leading-relaxed pt-1">
          Led by Michael &amp; Maria, veteran US travel guides with decades of Latin America immersion. Committed to cultural respect, traveler safety, and eco-friendly Latin America group trips.
        </p>
        <div class="flex flex-wrap gap-space-xs pt-space-xs">
          <span class="bg-surface-container-high text-on-surface px-space-sm py-space-xs rounded font-label-md text-[10px] tracking-wider uppercase">USA Guided Tours</span>
          <span class="bg-surface-container-high text-on-surface px-space-sm py-space-xs rounded font-label-md text-[10px] tracking-wider uppercase">100% Refund Guarantee</span>
          <span class="bg-surface-container-high text-on-surface px-space-sm py-space-xs rounded font-label-md text-[10px] tracking-wider uppercase">Latin America Trips</span>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-space-lg flex flex-col md:flex-row items-center justify-between gap-space-md font-caption text-caption text-on-surface-variant border-t border-outline-variant">
      <div class="flex items-center gap-space-md flex-wrap">
        <p>© 2026 Mountains to Coast Travel. Latin America Guided Tours &amp; USA Guided Tours. All rights reserved.</p>
        <a href="/terms" class="hover:text-on-surface transition-colors">Terms &amp; Conditions</a>
        <a href="/privacy" class="hover:text-on-surface transition-colors">Privacy Policy</a>
        <a href="/contact" class="hover:text-on-surface transition-colors">Contact</a>
      </div>
      <div class="flex items-center gap-space-xs text-secondary">
        <span class="material-symbols-outlined text-[16px]">eco</span>
        <span>Balancing Adventure &amp; Relaxation • Mountains &amp; Coasts</span>
      </div>
    </div>

  </div>
</footer>

