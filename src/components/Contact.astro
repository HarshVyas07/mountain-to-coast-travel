---
// Contact & Trip Booking Component based on PDF Content
---

<section id="contact" class="w-full py-space-2xl bg-surface-container-low scroll-mt-20">
  <div class="max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl">

      <!-- Left Column: Motivation, Destinations & Direct Contact (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-space-xs text-on-tertiary-container font-label-md text-label-md uppercase tracking-widest mb-space-xs font-semibold">
            <span class="material-symbols-outlined text-[18px]">airplane_ticket</span>
            <span>Plan Your Journey</span>
          </div>

          <h2 class="font-headline-lg text-headline-lg text-primary font-normal tracking-tight">
            Why Wait? Book a Trip with Us Now!
          </h2>

          <p class="font-body-md text-body-md text-on-surface-variant mt-space-sm leading-relaxed">
            Have you wanted to visit a country or region but hesitated because you do not know the language, customs, or security situation? 
          </p>

          <p class="font-body-md text-body-md text-on-surface mt-space-xs leading-relaxed font-medium">
            Mountains to Coast Travel is here to make your trips in the Americas a reality. Our expert travel guides will take you to explore some of the most beautiful areas of the region, prioritizing safety and fun.
          </p>

          <!-- Key Destinations -->
          <div class="mt-space-lg pt-space-md border-t border-surface-container-highest">
            <span class="font-label-md text-label-md uppercase tracking-widest text-secondary font-semibold">
              Destinations &amp; Departure Status:
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-3 font-body-md text-[13px] text-primary">
              <div class="flex items-center gap-1.5 p-1.5 rounded-lg bg-surface-container-highest/60 border border-primary/20">
                <span class="material-symbols-outlined text-[16px] text-secondary">event_available</span>
                <span><strong>Nicaragua:</strong> Feb 28 – Mar 7, 2027</span>
              </div>
              <div class="flex items-center gap-1.5 p-1.5 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px] text-outline">schedule</span>
                <span><strong>Costa Rica:</strong> Date Not Planned</span>
              </div>
              <div class="flex items-center gap-1.5 p-1.5 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px] text-outline">schedule</span>
                <span><strong>Guatemala:</strong> Date Not Planned</span>
              </div>
              <div class="flex items-center gap-1.5 p-1.5 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px] text-outline">schedule</span>
                <span><strong>Honduras:</strong> Date Not Planned</span>
              </div>
              <div class="flex items-center gap-1.5 p-1.5 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface-variant col-span-1 sm:col-span-2">
                <span class="material-symbols-outlined text-[16px] text-outline">schedule</span>
                <span><strong>El Salvador:</strong> Date Not Planned (Custom 5+ Inquiries Welcome)</span>
              </div>
            </div>
          </div>

          <!-- Direct Guide Contact Box -->
          <div class="mt-space-lg p-space-md bg-surface-container-lowest rounded-xl border border-outline-variant/30 flex flex-col gap-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-primary-container text-secondary-fixed flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]">support_agent</span>
              </div>
              <div>
                <span class="font-label-md text-[11px] uppercase tracking-wider text-secondary">Direct Personal Contact</span>
                <p class="font-label-lg text-label-lg text-primary font-bold">Michael &amp; Maria</p>
              </div>
            </div>

            <!-- Email & Phone Channels -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1 font-body-md text-[13px]">
              <a
                href="mailto:mheller@mountainstocoasttravel.com"
                class="flex items-center gap-2 p-2 rounded-lg bg-surface-container-low hover:bg-surface-container transition-colors text-primary"
              >
                <span class="material-symbols-outlined text-[18px] text-secondary">mail</span>
                <span class="truncate">mheller@mountainstocoasttravel.com</span>
              </a>
              <a
                href="tel:+14437225210"
                class="flex items-center gap-2 p-2 rounded-lg bg-surface-container-low hover:bg-surface-container transition-colors text-primary"
              >
                <span class="material-symbols-outlined text-[18px] text-secondary">phone</span>
                <span>+1 (443) 722-5210</span>
              </a>
            </div>

            <!-- WhatsApp Direct CTA -->
            <a
              href="https://wa.me/14437225210?text=Hello%20Mountains%20to%20Coast%20Travel!%20I%20would%20like%20to%20learn%20more%20about%20the%20Nicaragua%202027%20tour."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 bg-secondary-fixed text-primary font-label-md text-label-md uppercase tracking-wider py-2.5 px-3 rounded-lg hover:bg-primary hover:text-on-primary transition-colors text-center font-bold"
            >
              <span class="material-symbols-outlined text-[18px]">chat</span>
              <span>Open WhatsApp (+1 443-722-5210)</span>
            </a>

            <!-- Social Media Follow -->
            <div class="pt-2 border-t border-outline-variant/30 flex items-center justify-between text-caption font-caption text-secondary">
              <span>Follow our journeys:</span>
              <div class="flex items-center gap-2">
                <a
                  href="https://www.facebook.com/share/1DtmuAkLDi/?mibextid=wwXIfr"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 rounded-full bg-surface-container-low hover:bg-primary hover:text-on-primary flex items-center justify-center text-primary transition-colors"
                  aria-label="Facebook"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
                </a>
                <a
                  href="https://www.instagram.com/mountainstocoasttravel?dlrf=N3p1M3NoazNkZTYx&utm_source=qr"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 rounded-full bg-surface-container-low hover:bg-primary hover:text-on-primary flex items-center justify-center text-primary transition-colors"
                  aria-label="Instagram"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
                <a
                  href="https://www.tiktok.com/@mountaintocoasttravel?_r=1&_t=ZT-9AsityZTDQ5"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 rounded-full bg-surface-container-low hover:bg-primary hover:text-on-primary flex items-center justify-center text-primary transition-colors"
                  aria-label="TikTok"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Guarantees badge -->
        <div class="mt-space-md flex items-center gap-2 text-secondary font-caption text-caption">
          <span class="material-symbols-outlined text-[18px]">verified_user</span>
          <span>100% Refund Guarantee if minimum tour size is not reached.</span>
        </div>
      </div>

      <!-- Right Column: Booking / Trip Inquiry Form (7 cols) -->
      <div class="lg:col-span-7 bg-surface-container-lowest p-space-lg md:p-space-xl rounded-2xl border border-outline-variant/40 shadow-sm">
        <div class="flex flex-col gap-1 mb-space-md pb-space-sm border-b border-surface-container-highest">
          <h3 class="font-headline-sm text-headline-sm text-primary">Inquire About an Upcoming Tour or Custom Trip</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Tell us where you want to explore and your preferred travel style. We will respond within 24 hours.
          </p>
        </div>

        <form id="booking-inquiry-form" class="space-y-space-md">
          
          <!-- Name & Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
            <div class="flex flex-col gap-1">
              <label for="contact-name" class="font-label-md text-label-md uppercase tracking-wider text-secondary">
                Your Full Name *
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                placeholder="e.g. Sarah Jenkins"
                class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors"
              />
            </div>

            <div class="flex flex-col gap-1">
              <label for="contact-email" class="font-label-md text-label-md uppercase tracking-wider text-secondary">
                Email Address *
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder="sarah@example.com"
                class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors"
              />
            </div>
          </div>

          <!-- Phone & Travelers Count -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
            <div class="flex flex-col gap-1">
              <label for="contact-phone" class="font-label-md text-label-md uppercase tracking-wider text-secondary">
                Phone or WhatsApp (Optional)
              </label>
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                placeholder="+1 (555) 000-0000"
                class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors"
              />
            </div>

            <div class="flex flex-col gap-1">
              <label for="contact-guests" class="font-label-md text-label-md uppercase tracking-wider text-secondary">
                Number of Travelers
              </label>
              <select
                id="contact-guests"
                name="guests"
                class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors cursor-pointer"
              >
                <option value="1">Solo Explorer (1 person)</option>
                <option value="2" selected>Couple / Pair (2 people)</option>
                <option value="3-4">Small Group (3 – 4 people)</option>
                <option value="5+">Family / Friends Trip (5+ people - Custom Itinerary)</option>
                <option value="public-group">Joining Scheduled Public Group Tour</option>
              </select>
            </div>
          </div>

          <!-- Destination & Trip Style -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
            <div class="flex flex-col gap-1">
              <label for="contact-destination" class="font-label-md text-label-md uppercase tracking-wider text-secondary">
                Key Destination of Interest
              </label>
              <select
                id="contact-destination"
                name="destination"
                class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors cursor-pointer"
              >
                <option value="nicaragua" selected>Nicaragua (Feb 28 – Mar 7, 2027 • Reservations Open)</option>
                <option value="costa-rica">Costa Rica (Date Not Planned • Custom 5+)</option>
                <option value="guatemala">Guatemala &amp; Lake Atitlán (Date Not Planned • Custom 5+)</option>
                <option value="honduras">Honduras (Date Not Planned • Custom 5+)</option>
                <option value="el-salvador">El Salvador (Date Not Planned • Custom 5+)</option>
                <option value="not-sure">Undecided / Custom Request</option>
              </select>
            </div>

            <div class="flex flex-col gap-1">
              <label for="contact-timeframe" class="font-label-md text-label-md uppercase tracking-wider text-secondary">
                Target Travel Window / Season
              </label>
              <select
                id="contact-timeframe"
                name="timeframe"
                class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors cursor-pointer"
              >
                <option value="nicaragua-2027" selected>Feb 28 – Mar 7, 2027 (Nicaragua Group Tour)</option>
                <option value="spring-2027">Spring 2027 (Custom Dates • 5+ Guests)</option>
                <option value="summer-fall-2027">Summer / Fall 2027 (Custom Dates • 5+ Guests)</option>
                <option value="custom-dates">Flexible / Custom Dates (5+ Guests)</option>
              </select>
            </div>
          </div>

          <!-- Message / Special Desires -->
          <div class="flex flex-col gap-1">
            <label for="contact-notes" class="font-label-md text-label-md uppercase tracking-wider text-secondary">
              Tell Us About Your Desired Trip (Interests, Pace, Questions)
            </label>
            <textarea
              id="contact-notes"
              name="notes"
              rows="3"
              placeholder="e.g. We love hiking and local food, but also want comfortable eco-lodges and quiet coastal downtime. Any advice on Nicaragua vs. Costa Rica?"
              class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              class="w-full bg-primary-container text-on-primary py-space-md px-space-lg rounded font-label-lg text-label-lg uppercase tracking-widest hover:bg-primary transition-all flex items-center justify-center gap-space-xs shadow-md cursor-pointer"
            >
              <span>Submit Trip Inquiry</span>
              <span class="material-symbols-outlined text-[18px]">send</span>
            </button>
          </div>

          <!-- Success Alert Placeholder -->
          <div
            id="form-success-banner"
            class="hidden p-space-md bg-secondary-fixed text-primary rounded-xl border border-secondary text-center font-body-md text-[14px]"
          >
            <span class="material-symbols-outlined text-[20px] align-middle mr-1 text-primary">check_circle</span>
            <strong>Thank you!</strong> Your inquiry has been received. Michael &amp; Maria will review your trip details and contact you shortly.
          </div>

        </form>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('booking-inquiry-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('form-success-banner');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (successBanner) {
      successBanner.classList.remove('hidden');
      form.reset();
      successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
</script>
