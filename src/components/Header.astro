<style is:global>
  /* Guaranteed CSS hover & active states */
  #upcoming-tours-container:hover #upcoming-tours-menu,
  #upcoming-tours-container:focus-within #upcoming-tours-menu,
  #upcoming-tours-container.is-hovered #upcoming-tours-menu,
  #upcoming-tours-menu.is-open {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  #upcoming-tours-container:hover #tours-chevron,
  #upcoming-tours-container.is-hovered #tours-chevron {
    transform: rotate(180deg);
  }

  #upcoming-tours-menu {
    transform: translateY(6px);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s ease;
  }
</style>

<script>
  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  function closeMobileMenu() {
    mobileMenu?.classList.add('hidden');
    if (menuIcon) menuIcon.textContent = 'menu';
    mobileBtn?.setAttribute('aria-expanded', 'false');
  }

  mobileBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = mobileMenu?.classList.toggle('hidden');
    if (menuIcon) {
      menuIcon.textContent = isHidden ? 'menu' : 'close';
    }
    mobileBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
  });

  // Close mobile menu when clicking any navigation link
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    if (
      mobileMenu &&
      !mobileMenu.classList.contains('hidden') &&
      !mobileMenu.contains(e.target as Node) &&
      !mobileBtn?.contains(e.target as Node)
    ) {
      closeMobileMenu();
    }
  });

  // Mobile tours accordion toggle
  const mobileToursBtn = document.getElementById('mobile-tours-accordion-btn');
  const mobileToursSublist = document.getElementById('mobile-tours-sublist');
  const mobileToursIcon = document.getElementById('mobile-tours-icon');

  mobileToursBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = mobileToursSublist?.classList.toggle('hidden');
    if (mobileToursIcon) {
      mobileToursIcon.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
    }
  });

  // Desktop hover & click support
  const container = document.getElementById('upcoming-tours-container');
  const toursBtn = document.getElementById('upcoming-tours-btn');
  const toursMenu = document.getElementById('upcoming-tours-menu');

  // Mouse enter / leave helpers for rock-solid hover
  container?.addEventListener('mouseenter', () => {
    container.classList.add('is-hovered');
  });

  container?.addEventListener('mouseleave', () => {
    container.classList.remove('is-hovered');
    toursMenu?.classList.remove('is-open');
  });

  // Toggle on click
  toursBtn?.addEventListener('click', (e) => {
    // If not navigating away immediately, toggle
    if (toursMenu?.classList.contains('is-open')) {
      toursMenu.classList.remove('is-open');
      container?.classList.remove('is-hovered');
    } else {
      toursMenu?.classList.add('is-open');
      container?.classList.add('is-hovered');
    }
  });

  // Close desktop dropdown on outside click
  document.addEventListener('click', (e) => {
    if (!container?.contains(e.target as Node)) {
      toursMenu?.classList.remove('is-open');
      container?.classList.remove('is-hovered');
    }
  });
</script>
