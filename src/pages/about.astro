---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Meet Your US Travel Guides | Best Travel Guides | Mountains to Coast Travel";
const pageDescription = "Meet Michael and Maria, your dedicated USA travel guides at Mountains to Coast Travel. Decades of Latin America immersion leading the best guided tours and Latin America group trips.";
const pageKeywords = "us travel guides, best travel guides, usa travel guides, Mountains to travel coast, guided tours, usa guided tours, Latin America group trips, Latin America guided tours, guided tours of Nicaragua, guided tours of Costa Rica, guided tours of Guatemala, guided tours of Honduras, guided tours of El Salvador, guided tours of Peru";

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': 'https://mountainstocoasttravel.com/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Meet Your US Travel Guides',
      'item': 'https://mountainstocoasttravel.com/about'
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  image="/assets/images/IMG_5223.jpg"
  schema={breadcrumbSchema}
>
  <Header />

  <main class="w-full pt-20 bg-surface">

    <!-- About Hero -->
    <section class="w-full py-space-2xl bg-primary text-surface relative overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/assets/images/IMG_5223.jpg');"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#011209] via-[#011209]/80 to-[#011209]/45"></div>

      <div class="relative z-10 max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg pt-12 pb-6">
        <div class="flex items-center gap-2 text-secondary-fixed font-label-md text-label-md uppercase tracking-widest mb-3">
          <a href="/" class="hover:underline">Home</a>
          <span>/</span>
          <span class="text-surface font-semibold">About Your US Travel Guides</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg md:font-display-xl md:text-display-xl text-surface font-normal tracking-tight max-w-4xl">
          Meet Your US Travel Guides: Mountains to Coast Travel
        </h1>
        <p class="font-subhead text-subhead text-surface/85 mt-4 max-w-3xl leading-relaxed">
          Mountains to Coast Travel specializes in authentic guided tours and Latin America group trips, led by the best travel guides. Balancing adventure and relaxation, mountains and coasts, our USA travel guides bring decades of Latin American experience to every expedition.
        </p>
      </div>
    </section>

    <!-- Welcome / Our Story (PDF Slide 1) -->
    <section class="w-full py-space-2xl bg-surface">
      <div class="max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
          <div class="lg:col-span-6 flex flex-col gap-space-md scroll-reveal-left">
            <span class="font-label-md text-label-md uppercase tracking-widest text-on-tertiary-container font-semibold">Our Story &amp; Best Travel Guides Philosophy</span>
            <h2 class="font-headline-lg text-headline-lg text-primary font-normal tracking-tight">
              Journeys Shaped by Nature, Warm Moments, and Adventure.
            </h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
              Mountains to Coast Travel was created for travellers and explorers looking for meaningful experiences — the kind shaped by nature, warm moments, and a touch of adventure.
            </p>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              Whether you’re seeking quiet mountain mornings enveloped in misty cloud forests or breezy coastal sunsets over Pacific and Caribbean waters, our USA travel guides design journeys that feel personal, grounded, and unforgettable.
            </p>
            <div class="p-space-md bg-surface-container-low rounded-xl border-l-4 border-primary">
              <p class="font-body-md text-primary italic font-medium">
                "We don't do oversized tour buses or rushed checklists. We invite you into the living rhythms of Latin America with genuine US travel guides who love what they do."
              </p>
            </div>
          </div>

          <div class="lg:col-span-6 scroll-reveal-right">
            <div class="relative rounded-2xl overflow-hidden shadow-xl bg-surface-container h-[420px]">
              <img
                src="/assets/images/IMG_4036.jpg"
                alt="Cloud forest suspension bridge in Monteverde - Mountains to Coast Travel"
                class="w-full h-full object-cover"
              />
              <div class="absolute bottom-4 left-4 right-4 bg-primary/80 backdrop-blur-md p-3 rounded-xl text-surface font-caption text-caption">
                <span class="font-label-md uppercase tracking-wider text-secondary-fixed block">Monteverde Cloud Canopy</span>
                Connecting mountain highlands with coastal sanctuaries across the isthmus.
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3 Commitments Section (PDF Slide 3) -->
    <section class="w-full py-space-2xl bg-surface-container-low border-y border-outline-variant/30">
      <div class="max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg">
        
        <div class="max-w-2xl mb-space-2xl">
          <span class="font-label-md text-label-md uppercase tracking-widest text-on-tertiary-container font-semibold">What Guides Us</span>
          <h2 class="font-headline-lg text-headline-lg text-primary font-normal tracking-tight mt-1">
            Our Three Central Pillars
          </h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant mt-2">
            Every Mountains to Coast journey is built on three unwavering principles that ensure your experience is comfortable, respectful, and safe.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg stagger-children">
          
          <!-- Pillar 1 -->
          <div class="bg-surface-container-lowest p-space-xl rounded-2xl border border-outline-variant/30 flex flex-col justify-between shadow-sm">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-secondary-fixed text-primary flex items-center justify-center mb-space-md shadow-sm">
                <span class="material-symbols-outlined text-[30px]">nature_people</span>
              </div>
              <span class="font-caption text-caption uppercase tracking-widest text-secondary font-bold">Pillar 01</span>
              <h3 class="font-headline-sm text-headline-sm text-primary mt-1 mb-2">Comfort &amp; Green Practices</h3>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                An appropriate balance between comfort and environmentally-friendly practices. We stay in hand-selected eco-lodges and boutique villas that protect nature while ensuring restful, comfortable nights. You will have a lot of fun exploring new places!
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-surface-container-high text-secondary font-label-md text-label-md uppercase tracking-wider flex items-center gap-1.5 font-bold">
              <span class="material-symbols-outlined text-[18px]">verified</span> Eco-Conscious Comfort
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="bg-surface-container-lowest p-space-xl rounded-2xl border border-outline-variant/30 flex flex-col justify-between shadow-sm">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-secondary-fixed text-primary flex items-center justify-center mb-space-md shadow-sm">
                <span class="material-symbols-outlined text-[30px]">handshake</span>
              </div>
              <span class="font-caption text-caption uppercase tracking-widest text-secondary font-bold">Pillar 02</span>
              <h3 class="font-headline-sm text-headline-sm text-primary mt-1 mb-2">Respect for Culture</h3>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                A central respect for the culture we are visiting. We partner with indigenous families, local fincas, and neighborhood artisans. Through travel, we learn and can exchange ideas, culinary traditions, and practices with dignity and warmth.
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-surface-container-high text-secondary font-label-md text-label-md uppercase tracking-wider flex items-center gap-1.5 font-bold">
              <span class="material-symbols-outlined text-[18px]">verified</span> Mutual Cultural Exchange
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="bg-surface-container-lowest p-space-xl rounded-2xl border border-outline-variant/30 flex flex-col justify-between shadow-sm">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-secondary-fixed text-primary flex items-center justify-center mb-space-md shadow-sm">
                <span class="material-symbols-outlined text-[30px]">shield</span>
              </div>
              <span class="font-caption text-caption uppercase tracking-widest text-secondary font-bold">Pillar 03</span>
              <h3 class="font-headline-sm text-headline-sm text-primary mt-1 mb-2">Priority for Safety</h3>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                A priority for safety. We know the areas intimately and will help you navigate regional customs, trusted drivers, reputable routes, and avoid foods and situations that may lessen your enjoyment. Travel with total peace of mind.
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-surface-container-high text-secondary font-label-md text-label-md uppercase tracking-wider flex items-center gap-1.5 font-bold">
              <span class="material-symbols-outlined text-[18px]">verified</span> Seasoned Local Oversight
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Meet Your Guides (PDF Slide 5) -->
    <section class="w-full py-space-2xl bg-surface">
      <div class="max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-2xl">
          <div>
            <span class="font-label-md text-label-md uppercase tracking-widest text-on-tertiary-container font-semibold">Leadership in the Field</span>
            <h2 class="font-headline-lg text-headline-lg text-primary font-normal tracking-tight mt-1">
              Meet Your Guide(s): Michael &amp; Maria
            </h2>
            <p class="font-subhead text-subhead text-on-surface-variant max-w-2xl mt-2 leading-relaxed">
              Michael and Maria have decades of experience travelling throughout the region, and one or both of them will be delighted to lead your group on an unforgettable trip.
            </p>
          </div>
          <div class="flex items-center gap-2 bg-secondary-fixed text-primary px-space-md py-space-xs rounded-full font-label-md text-label-md uppercase tracking-wider shrink-0 font-bold">
            <span class="material-symbols-outlined text-[18px]">translate</span>
            <span>Bilingual Guides (English &amp; Spanish)</span>
          </div>
        </div>

        <!-- Guides Bios Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-xl stagger-children">
          
          <!-- Guide 1: Michael -->
          <div class="bg-surface-container-low p-space-lg md:p-space-xl rounded-3xl border border-outline-variant/40 flex flex-col justify-between shadow-sm">
            <div>
              <div class="flex items-center gap-space-md mb-space-lg">
                <div class="w-20 h-20 rounded-2xl bg-primary text-secondary-fixed flex items-center justify-center font-headline-md text-headline-md shrink-0 shadow-md">
                  <span class="material-symbols-outlined text-[40px]">hiking</span>
                </div>
                <div>
                  <h3 class="font-headline-md text-headline-md text-primary">Michael</h3>
                  <span class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                    Co-Founder &amp; Expedition Leader
                  </span>
                  <span class="block text-secondary font-caption text-caption mt-0.5">20+ Years Traveling Central &amp; South America</span>
                </div>
              </div>

              <div class="space-y-3 font-body-md text-body-md text-on-surface-variant leading-relaxed">
                <p>
                  A fluent Spanish speaker, Michael majored in Latin American Studies and has spent more than two decades traveling in the region, frequenting Central and South American countries for both work and pleasure.
                </p>
                <p>
                  His background combines deep academic understanding of regional history and geography with practical, on-the-ground experience navigating everything from remote mountain passes to border crossings and coastal logistics.
                </p>
              </div>

              <div class="mt-space-md pt-space-md border-t border-surface-container-highest space-y-2 font-caption text-caption text-primary">
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-on-tertiary-container">school</span>
                  <span>B.A. in Latin American Studies • Fluent Spanish Speaker</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-on-tertiary-container">map</span>
                  <span>Two Decades of Regional Route Curation &amp; Safe Transport</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-on-tertiary-container">support</span>
                  <span>Logistics, Day-to-Day Details, and Risk Prevention</span>
                </div>
              </div>
            </div>

            <div class="mt-space-md pt-space-md border-t border-surface-container-highest">
              <span class="font-body-md text-primary italic font-medium block">
                "We make sure your trip is seamless, so you can take in every mountain sunrise and ocean wave without a single logistical headache."
              </span>
            </div>
          </div>

          <!-- Guide 2: Maria -->
          <div class="bg-surface-container-low p-space-lg md:p-space-xl rounded-3xl border border-outline-variant/40 flex flex-col justify-between shadow-sm">
            <div>
              <div class="flex items-center gap-space-md mb-space-lg">
                <div class="w-20 h-20 rounded-2xl bg-primary text-secondary-fixed flex items-center justify-center font-headline-md text-headline-md shrink-0 shadow-md">
                  <span class="material-symbols-outlined text-[40px]">favorite</span>
                </div>
                <div>
                  <h3 class="font-headline-md text-headline-md text-primary">Maria</h3>
                  <span class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                    Co-Founder &amp; Cultural Ambassador
                  </span>
                  <span class="block text-secondary font-caption text-caption mt-0.5">Native Nicaraguan • Cultural Immersion Host</span>
                </div>
              </div>

              <div class="space-y-3 font-body-md text-body-md text-on-surface-variant leading-relaxed">
                <p>
                  Originally from Nicaragua, Maria loves taking people to new places and sharing her culture. Maria has spent most of her life traveling between the United States and Nicaragua, also visiting other countries in Central and South America.
                </p>
                <p>
                  Her deep personal relationships across the isthmus open doors that typical tourists never see — from private family-run coffee fincas and artisan workshops to the most vibrant local food markets and welcoming village gatherings.
                </p>
              </div>

              <div class="mt-space-md pt-space-md border-t border-surface-container-highest space-y-2 font-caption text-caption text-primary">
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-on-tertiary-container">home_pin</span>
                  <span>Native Nicaraguan Heritage &amp; Cross-Cultural Bridge</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-on-tertiary-container">restaurant</span>
                  <span>Culinary Specialist &amp; Local Artisan Community Host</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-on-tertiary-container">group</span>
                  <span>Warm, Personal Care &amp; Meaningful Group Dynamics</span>
                </div>
              </div>
            </div>

            <div class="mt-space-md pt-space-md border-t border-surface-container-highest">
              <span class="font-body-md text-primary italic font-medium block">
                "Sharing the warmth, music, and spirit of my homeland with visitors is my greatest joy. You arrive as guests and leave as family."
              </span>
            </div>
          </div>

        </div>

        <!-- The Human Touch vs AI Callout (PDF Slide 8) -->
        <div class="mt-space-xl bg-surface-container-highest/70 p-space-lg md:p-space-xl rounded-2xl border border-outline-variant/40 flex flex-col md:flex-row items-center justify-between gap-space-lg scroll-reveal-scale">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary text-secondary-fixed flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[28px]">psychology_alt</span>
            </div>
            <div>
              <h4 class="font-headline-sm text-headline-sm text-primary font-medium">
                The Real-World Difference: Why Work With Us Over AI
              </h4>
              <p class="font-body-md text-body-md text-on-surface-variant mt-1 leading-relaxed">
                AI can only do so much when planning a trip; work with the travel professionals who have been to the locations, speak the language, appreciate the culture, and prioritize a sense of fun! Mountains to Coast guides speak Spanish and English and are intimately familiar with local cultures of our destination countries.
              </p>
            </div>
          </div>
          <a
            href="/contact"
            class="bg-primary text-on-primary px-space-lg py-space-sm rounded font-label-lg text-label-lg uppercase tracking-wider hover:bg-primary-container transition-all shrink-0 text-center"
          >
            Talk to Michael &amp; Maria
          </a>
        </div>

      </div>
    </section>

    <!-- Destinations Overview (PDF Slide 4) -->
    <section class="w-full py-space-2xl bg-surface-container-low border-t border-outline-variant/30">
      <div class="max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg">
        
        <div class="text-center max-w-2xl mx-auto mb-space-2xl">
          <span class="font-label-md text-label-md uppercase tracking-widest text-on-tertiary-container font-semibold">Where We Guide</span>
          <h2 class="font-headline-lg text-headline-lg text-primary font-normal tracking-tight mt-1">
            Key Destinations Across Latin America
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-2">
            From volcanic calderas to Pacific surf coasts, Caribbean coral atolls, and Andean Inca citadels.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-space-md stagger-children">
          <!-- Destination 01: Nicaragua -->
          <div class="bg-surface-container-lowest p-space-md rounded-2xl border-2 border-secondary shadow-md">
            <div class="flex items-center justify-between mb-1">
              <span class="font-label-md text-[11px] uppercase tracking-widest text-secondary font-bold">Destination 01</span>
              <span class="text-[10px] bg-primary text-on-primary px-2 py-0.5 rounded font-bold uppercase tracking-wider">Confirmed 2027</span>
            </div>
            <h3 class="font-headline-sm text-primary mt-1 font-bold">Nicaragua: Nature is Waiting</h3>
            <p class="font-caption text-caption text-secondary font-bold mt-0.5">
              Feb 28 — Mar 7, 2027 • 9 Days 8 Nights • Reservations Open
            </p>
            <p class="font-caption text-caption text-on-surface-variant mt-2 leading-relaxed">
              Walk colorful colonial Granada streets, sail across Lake Nicaragua to twin-volcano Ometepe Island, fly to Caribbean Corn Island's turquoise waters, swim in volcanic Laguna de Apoyo, taste the best coffee, and watch for our national bird, the Guardabarranco. Viajemos juntos!
            </p>
            <a href="/nicaragua" class="inline-flex items-center gap-1 font-label-md text-[11px] uppercase tracking-wider text-primary font-bold mt-3 hover:text-secondary">
              View Nicaragua Itinerary <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
            </a>
          </div>

          <!-- Destination 02: Costa Rica -->
          <div class="bg-surface-container-lowest p-space-md rounded-2xl border border-outline-variant/30">
            <div class="flex items-center justify-between mb-1">
              <span class="font-label-md text-[11px] uppercase tracking-widest text-secondary font-bold">Destination 02</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Date Not Planned</span>
            </div>
            <h3 class="font-headline-sm text-primary mt-1">Costa Rica</h3>
            <p class="font-caption text-caption text-on-surface-variant mt-1">
              Arenal Volcano steaming hot springs, Monteverde cloud forest canopy walkways, and Manuel Antonio's rainforest beaches. Custom dates welcome for groups of 5+.
            </p>
            <a href="/costa-rica" class="inline-flex items-center gap-1 font-label-md text-[11px] uppercase tracking-wider text-primary font-bold mt-3 hover:text-secondary">
              View Costa Rica Itinerary <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
            </a>
          </div>

          <!-- Destination 03: Guatemala -->
          <div class="bg-surface-container-lowest p-space-md rounded-2xl border border-outline-variant/30">
            <div class="flex items-center justify-between mb-1">
              <span class="font-label-md text-[11px] uppercase tracking-widest text-secondary font-bold">Destination 03</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Date Not Planned</span>
            </div>
            <h3 class="font-headline-sm text-primary mt-1">Guatemala</h3>
            <p class="font-caption text-caption text-on-surface-variant mt-1">
              Lake Atitlán volcanic waters, Santiago master weavers, Antigua colonial coffee fincas, and Tikal Mayan temples in dawn mist. Custom dates welcome for groups of 5+.
            </p>
            <a href="/guatemala" class="inline-flex items-center gap-1 font-label-md text-[11px] uppercase tracking-wider text-primary font-bold mt-3 hover:text-secondary">
              View Guatemala Itinerary <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
            </a>
          </div>

          <!-- Destination 04: Honduras -->
          <div class="bg-surface-container-lowest p-space-md rounded-2xl border border-outline-variant/30">
            <div class="flex items-center justify-between mb-1">
              <span class="font-label-md text-[11px] uppercase tracking-widest text-secondary font-bold">Destination 04</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Date Not Planned</span>
            </div>
            <h3 class="font-headline-sm text-primary mt-1">Honduras</h3>
            <p class="font-caption text-caption text-on-surface-variant mt-1">
              Copán Ruinas archaeological stelae, Pico Bonito dense national park canopy, and Cangrejal river suspension bridges. Custom dates welcome for groups of 5+.
            </p>
            <a href="/honduras" class="inline-flex items-center gap-1 font-label-md text-[11px] uppercase tracking-wider text-primary font-bold mt-3 hover:text-secondary">
              View Honduras Itinerary <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
            </a>
          </div>

          <!-- Destination 05: El Salvador -->
          <div class="bg-surface-container-lowest p-space-md rounded-2xl border border-outline-variant/30">
            <div class="flex items-center justify-between mb-1">
              <span class="font-label-md text-[11px] uppercase tracking-widest text-secondary font-bold">Destination 05</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Date Not Planned</span>
            </div>
            <h3 class="font-headline-sm text-primary mt-1">El Salvador</h3>
            <p class="font-caption text-caption text-on-surface-variant mt-1">
              Santa Ana sulfur crater lake, Ruta de las Flores mountain villages, artisanal pupusas, and Pacific surf coastlines. Custom dates welcome for groups of 5+.
            </p>
            <a href="/el-salvador" class="inline-flex items-center gap-1 font-label-md text-[11px] uppercase tracking-wider text-primary font-bold mt-3 hover:text-secondary">
              View El Salvador Itinerary <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
            </a>
          </div>

          <!-- Destination 06: Peru -->
          <div class="bg-surface-container-lowest p-space-md rounded-2xl border border-outline-variant/30">
            <div class="flex items-center justify-between mb-1">
              <span class="font-label-md text-[11px] uppercase tracking-widest text-secondary font-bold">Destination 06</span>
              <span class="text-[10px] bg-surface-container-high text-on-surface-variant px-1.5 py-0.5 rounded uppercase">Date Not Planned</span>
            </div>
            <h3 class="font-headline-sm text-primary mt-1">Peru</h3>
            <p class="font-caption text-caption text-on-surface-variant mt-1">
              Inca imperial capital Cusco, Sacred Valley agricultural terraces, Pisac artisan markets, and dawn sunrise at Machu Picchu. Custom dates welcome for groups of 5+.
            </p>
            <a href="/peru" class="inline-flex items-center gap-1 font-label-md text-[11px] uppercase tracking-wider text-primary font-bold mt-3 hover:text-secondary">
              View Peru Itinerary <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
            </a>
          </div>

