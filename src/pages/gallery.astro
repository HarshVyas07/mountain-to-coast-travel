const pageTitle = "Latin America Guided Tours Photo Gallery | Mountains to Coast Travel";
const pageDescription = "Explore authentic field photography from our Latin America guided tours across Nicaragua, Costa Rica, Guatemala, Honduras, El Salvador, and Peru. Led by top US travel guides.";
const pageKeywords = "guided tours, Latin America guided tours, usa guided tours, Latin America group trips, us travel guides, best travel guides, usa travel guides, Mountains to travel coast, guided tours of Nicaragua, guided tours of Costa Rica, guided tours of Guatemala, guided tours of Honduras, guided tours of El Salvador, guided tours of Peru";

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
