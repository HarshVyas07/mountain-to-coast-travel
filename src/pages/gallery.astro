---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  image="/assets/images/IMG_5223.jpg"
  schema={breadcrumbSchema}
>
  <Header />

  <main class="w-full pt-20 bg-surface">

    <!-- Gallery Hero (Ultra-HD Background) -->
    <section class="w-full py-space-2xl bg-primary text-surface relative overflow-hidden min-h-[420px] flex items-center">
      <div 
        class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 scale-105" 
        style="background-image: url('/assets/images/IMG_5223.jpg');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#011209] via-[#011209]/75 to-[#011209]/45"></div>

      <div class="relative z-10 max-w-[1440px] mx-auto w-full px-margin md:px-margin-md lg:px-margin-lg pt-12 pb-6">
        <div class="flex items-center gap-2 text-secondary-fixed font-label-md text-label-md uppercase tracking-widest mb-3">
          <a href="/" class="hover:underline">Home</a>
          <span>/</span>
          <span class="text-surface font-semibold">Latin America Guided Tours Gallery</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg md:font-display-xl md:text-display-xl text-surface font-normal tracking-tight max-w-4xl">
          Latin America Guided Tours: Field Photo Archive
        </h1>
        <p class="font-subhead text-subhead text-surface/90 mt-4 max-w-2xl leading-relaxed drop-shadow-sm">
          Unrehearsed glimpses documented by Michael, Maria, and our expedition naturalists during our guided tours across Costa Rica, Nicaragua, Guatemala, Honduras, El Salvador, and Peru.
        </p>

        <div class="flex flex-wrap items-center gap-4 mt-6 text-secondary-fixed font-label-md text-label-md uppercase tracking-wider">
          <span class="flex items-center gap-1.5 bg-surface/10 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
            <span class="material-symbols-outlined text-[18px]">photo_camera</span>
            Field Log Archive • 100% Authentic Expedition Photography
          </span>
          <span class="hidden sm:inline opacity-40">|</span>
          <span class="text-surface/80 text-xs">Click any photograph for High-Definition Lightbox</span>
        </div>
      </div>
    </section>

    <!-- Filter Buttons & Controls (Sticky) -->
    <section class="w-full py-space-md bg-surface-container-low border-b border-outline-variant/30 sticky top-20 z-30 backdrop-blur-md bg-surface-container-low/95 shadow-sm">
      <div class="max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg flex items-center justify-between gap-4 overflow-x-auto pb-1">
        <div class="flex items-center gap-2 shrink-0" id="gallery-filters">
          <button
            class="gallery-filter-btn active bg-primary text-on-primary px-4 py-1.5 rounded-full font-label-md text-label-md uppercase tracking-wider transition-all shadow-sm cursor-pointer"
            data-filter="all"
            type="button"
          >
            All Archive ({galleryItems.length})
          </button>
          <button
            class="gallery-filter-btn bg-surface-container-lowest text-on-surface hover:bg-surface-container px-4 py-1.5 rounded-full font-label-md text-label-md uppercase tracking-wider transition-all border border-outline-variant/30 cursor-pointer"
            data-filter="forest"
            type="button"
          >
            Cloud Forests &amp; Mountains
          </button>
          <button
            class="gallery-filter-btn bg-surface-container-lowest text-on-surface hover:bg-surface-container px-4 py-1.5 rounded-full font-label-md text-label-md uppercase tracking-wider transition-all border border-outline-variant/30 cursor-pointer"
            data-filter="ocean"
            type="button"
          >
            Coastlines &amp; Coral Reefs
          </button>
          <button
            class="gallery-filter-btn bg-surface-container-lowest text-on-surface hover:bg-surface-container px-4 py-1.5 rounded-full font-label-md text-label-md uppercase tracking-wider transition-all border border-outline-variant/30 cursor-pointer"
            data-filter="heritage"
            type="button"
          >
            Living Heritage &amp; Culture
          </button>
          <button
            class="gallery-filter-btn bg-surface-container-lowest text-on-surface hover:bg-surface-container px-4 py-1.5 rounded-full font-label-md text-label-md uppercase tracking-wider transition-all border border-outline-variant/30 cursor-pointer"
            data-filter="wildlife"
            type="button"
          >
            Wildlife &amp; Sanctuaries
          </button>
        </div>

        <a
          href="/tours"
          class="hidden sm:inline-flex items-center gap-1 font-label-md text-label-md uppercase tracking-wider text-primary hover:text-secondary font-bold shrink-0"
        >
          <span>View Tour Dates</span>
          <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
        </a>
      </div>
    </section>

    <!-- Asymmetrical Gallery Grid with 3D Depth -->
    <section class="w-full py-space-2xl bg-surface">
      <div class="max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg">
        
        <div class="grid grid-cols-1 md:grid-cols-12 gap-space-md" id="gallery-grid">
          {galleryItems.map((item, index) => (
            <div
              class={`gallery-card group relative overflow-hidden rounded-2xl bg-surface-container shadow-md hover:shadow-2xl transition-all duration-500 cursor-pointer ${item.spanClass}`}
              data-category={item.category}
              data-index={index}
              data-full-image={item.image}
              data-title={item.title}
              data-location={item.location}
              data-country={item.country}
              data-caption={item.caption}
              data-format={item.format}
            >
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              
              <!-- Top Badges -->
              <div class="absolute top-4 left-4 flex items-center gap-2 z-10">
                <span class="bg-primary/90 backdrop-blur-md text-on-primary font-label-md text-[11px] uppercase tracking-wider px-2.5 py-1 rounded-full shadow-sm">
                  {item.country}
                </span>
                <span class="bg-surface/90 backdrop-blur-md text-primary font-label-md text-[10px] uppercase tracking-wider px-2.5 py-1 rounded-full shadow-sm hidden sm:inline">
                  {item.format}
                </span>
              </div>

              <!-- Top Right Zoom Icon Indicator -->
              <div class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center text-surface opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <span class="material-symbols-outlined text-[20px]">fullscreen</span>
              </div>

              <!-- Bottom Editorial Caption Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#011209]/90 via-[#011209]/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-space-lg text-surface">
                <span class="font-label-md text-[11px] uppercase tracking-widest text-secondary-fixed mb-1">
                  {item.location}
                </span>
                <h3 class="font-headline-sm text-[18px] font-medium leading-snug text-surface">
                  {item.title}
                </h3>
                <p class="font-body-md text-[13px] text-surface/85 mt-1 line-clamp-2">
                  {item.caption}
                </p>
                <div class="mt-3 pt-2 border-t border-surface/20 flex items-center justify-between text-secondary-fixed font-caption text-[11px]">
                  <span>Click to view HD photo</span>
                  <span class="text-surface font-semibold inline-flex items-center gap-1">
                    Expand Details <span class="material-symbols-outlined text-[14px]">zoom_in</span>
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- Bottom Dispatch CTA -->
    <section class="w-full py-space-2xl bg-surface-container-low border-t border-outline-variant/30 text-center">
      <div class="max-w-[760px] mx-auto px-margin scroll-reveal">
        <span class="font-label-md text-label-md uppercase tracking-widest text-on-tertiary-container font-semibold">Live The Journey</span>
        <h2 class="font-headline-lg text-headline-lg text-primary font-normal mt-1">
          Every Photo is an Invitation.
        </h2>
        <p class="font-subhead text-subhead text-on-surface-variant mt-2">
          From volcanic cloud forests to secluded Caribbean coral atolls, these experiences await your family or private group.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 mt-6">
          <a
            href="/tours"
            class="bg-primary text-on-primary px-space-lg py-space-sm rounded font-label-lg text-label-lg uppercase tracking-wider hover:bg-primary-container transition-all shadow-md"
          >
            Explore 2026 – 2027 Tours
          </a>
          <a
            href="/contact"
            class="bg-surface-container-lowest text-primary border border-outline-variant px-space-lg py-space-sm rounded font-label-lg text-label-lg uppercase tracking-wider hover:bg-surface-container transition-all"
          >
            Plan a Bespoke Trip (5+ Guests)
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- Interactive Lightbox Modal -->
  <div 
    id="lightbox-modal" 
    class="fixed inset-0 z-[120] bg-primary/95 backdrop-blur-md hidden items-center justify-center p-4 md:p-8"
  >
    <div class="relative w-full max-w-5xl bg-surface-container-lowest rounded-2xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]">
      
      <!-- Lightbox Header -->
      <div class="flex items-center justify-between px-6 py-4 bg-surface-container border-b border-outline-variant/30">
        <div class="flex items-center gap-2">
          <span id="lb-country" class="bg-primary text-on-primary font-label-md text-[10px] uppercase tracking-wider px-2 py-0.5 rounded">Costa Rica</span>
          <span id="lb-location" class="font-label-md text-xs uppercase tracking-wider text-secondary font-semibold">Monteverde</span>
        </div>
        <button 
          id="lb-close-btn" 
          class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface hover:bg-surface-variant transition-colors cursor-pointer"
          type="button"
          aria-label="Close Lightbox"
        >
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <!-- Lightbox Image Viewport -->
      <div class="relative flex-1 bg-black flex items-center justify-center overflow-hidden min-h-[300px] md:min-h-[500px]">
        <img 
          id="lb-image" 
          src="" 
          alt="" 
          class="max-h-[65vh] w-auto max-w-full object-contain transition-opacity duration-300"
        />
        
        <!-- Navigation Arrows -->
        <button 
          id="lb-prev-btn"
          class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/50 text-white flex items-center justify-center hover:bg-black/80 transition-all cursor-pointer backdrop-blur-sm"
          type="button"
          aria-label="Previous image"
        >
          <span class="material-symbols-outlined text-[24px]">chevron_left</span>
        </button>
        <button 
          id="lb-next-btn"
          class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/50 text-white flex items-center justify-center hover:bg-black/80 transition-all cursor-pointer backdrop-blur-sm"
          type="button"
          aria-label="Next image"
        >
          <span class="material-symbols-outlined text-[24px]">chevron_right</span>
        </button>
      </div>

      <!-- Lightbox Footer Details -->
      <div class="p-6 bg-surface-container-lowest border-t border-outline-variant/20 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h3 id="lb-title" class="font-headline-sm text-lg text-primary font-bold">Photo Title</h3>
          <p id="lb-caption" class="font-body-md text-xs text-on-surface-variant mt-1 max-w-2xl leading-relaxed">Photo Caption</p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <span id="lb-format" class="text-xs text-secondary font-label-md uppercase tracking-wider">Archive Capture</span>
          <a href="/tours" class="bg-primary text-on-primary px-4 py-2 rounded font-label-md text-xs uppercase tracking-wider hover:bg-primary-container transition-all">
            Join Tour
          </a>
        </div>
      </div>

    </div>
  </div>

  <Footer />
</Layout>

<script>
  // Category filter client-side logic
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const cards = document.querySelectorAll('.gallery-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-primary', 'text-on-primary');
        b.classList.add('bg-surface-container-lowest', 'text-on-surface');
      });
      btn.classList.add('active', 'bg-primary', 'text-on-primary');
      btn.classList.remove('bg-surface-container-lowest', 'text-on-surface');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Lightbox Modal Logic
  const lightbox = document.getElementById('lightbox-modal');
  const lbImage = document.getElementById('lb-image') as HTMLImageElement | null;
  const lbTitle = document.getElementById('lb-title');
  const lbLocation = document.getElementById('lb-location');
  const lbCountry = document.getElementById('lb-country');
  const lbCaption = document.getElementById('lb-caption');
  const lbFormat = document.getElementById('lb-format');
  const closeBtn = document.getElementById('lb-close-btn');
  const prevBtn = document.getElementById('lb-prev-btn');
  const nextBtn = document.getElementById('lb-next-btn');

  let activeIndex = 0;
  const cardElements = Array.from(cards) as HTMLElement[];

  function openLightbox(index: number) {
    if (!cardElements[index]) return;
    activeIndex = index;
    const card = cardElements[index];

    if (lbImage) lbImage.src = card.getAttribute('data-full-image') || '';
    if (lbTitle) lbTitle.textContent = card.getAttribute('data-title') || '';
    if (lbLocation) lbLocation.textContent = card.getAttribute('data-location') || '';
    if (lbCountry) lbCountry.textContent = card.getAttribute('data-country') || '';
    if (lbCaption) lbCaption.textContent = card.getAttribute('data-caption') || '';
    if (lbFormat) lbFormat.textContent = card.getAttribute('data-format') || '';

    lightbox?.classList.remove('hidden');
    lightbox?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function nextImage() {
    let nextIdx = (activeIndex + 1) % cardElements.length;
    openLightbox(nextIdx);
  }

  function prevImage() {
    let prevIdx = (activeIndex - 1 + cardElements.length) % cardElements.length;
    openLightbox(prevIdx);
  }

  cardElements.forEach((card, idx) => {
    card.addEventListener('click', () => openLightbox(idx));
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', prevImage);
  nextBtn?.addEventListener('click', nextImage);

  // Close on backdrop click
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // Keyboard controls
  window.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('flex')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    }
  });

  // 3D Card Hover Depth
  cardElements.forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      card.style.transform = `perspective(800px) rotateX(${-y / 35}deg) rotateY(${x / 35}deg) scale3d(1.01, 1.01, 1.01)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });
</script>
