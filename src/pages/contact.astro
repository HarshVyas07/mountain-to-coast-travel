---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Book USA Guided Tours & Group Trips | Mountains to Coast Travel";
const pageDescription = "Contact Mountains to Coast Travel to book USA guided tours or custom Latin America group trips with veteran US travel guides Michael & Maria. Call +1 (443) 722-5210.";
const pageKeywords = "guided tours, usa guided tours, Latin America guided tours, Latin America group trips, us travel guides, best travel guides, usa travel guides, Mountains to travel coast, guided tours of Nicaragua, guided tours of Costa Rica, guided tours of Guatemala, guided tours of Honduras, guided tours of El Salvador, guided tours of Peru";

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': 'https://mountainstocoasttravel.com/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Contact & Book Guided Tours',
      'item': 'https://mountainstocoasttravel.com/contact'
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  image="/assets/images/IMG_2856.jpg"
  schema={breadcrumbSchema}
>
  <Header />

  <main class="w-full pt-20 bg-surface">

    <!-- Contact Hero (From PDF Slide 2 & 4) -->
    <section class="w-full py-space-2xl bg-primary text-surface relative overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/assets/images/IMG_2856.jpg');"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#011209] via-[#011209]/80 to-[#011209]/45"></div>

      <div class="relative z-10 max-w-[1440px] mx-auto w-full px-margin md:px-margin-md lg:px-margin-lg pt-12 pb-6">
        <div class="flex items-center gap-2 text-secondary-fixed font-label-md text-label-md uppercase tracking-widest mb-3">
          <a href="/" class="hover:underline">Home</a>
          <span>/</span>
          <span class="text-surface font-semibold">Contact &amp; Book Tours</span>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-surface/10 backdrop-blur-md mb-3 text-secondary-fixed font-label-md text-label-md uppercase tracking-widest">
          <span class="material-symbols-outlined text-[16px]">pin_drop</span>
          <span>USA Guided Tours &bull; Latin America Group Trips</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg md:font-display-xl md:text-display-xl text-surface font-normal tracking-tight max-w-4xl">
          Book USA Guided Tours &amp; Latin America Group Trips
        </h1>
        <p class="font-subhead text-subhead text-surface/85 mt-4 max-w-3xl leading-relaxed">
          Have you wanted to visit Latin America but hesitated because of language, customs, or safety? Mountains to Coast Travel is here to make your journey effortless. Our seasoned US travel guides lead the best guided tours across Nicaragua, Costa Rica, Guatemala, Honduras, El Salvador, and Peru, prioritizing safety, comfort, and authentic joy.
        </p>
      </div>
    </section>

    <!-- Main Content & Booking Form -->
    <section class="w-full py-space-2xl bg-surface">
      <div class="max-w-[1440px] mx-auto px-margin md:px-margin-md lg:px-margin-lg">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl">
          
          <!-- Left Column: Guide Channels & Destinations (5 cols) -->
          <div class="lg:col-span-5 flex flex-col justify-between scroll-reveal-left">
            <div>
              <span class="font-label-md text-label-md uppercase tracking-widest text-on-tertiary-container font-semibold">Get In Touch</span>
              <h2 class="font-headline-md text-headline-md text-primary font-normal mt-1">
                Direct Guidance from Seasoned Travelers
              </h2>
              <p class="font-body-md text-body-md text-on-surface-variant mt-2 leading-relaxed">
                When you contact Mountains to Coast Travel, you talk directly with Michael and Maria — the co-founders and guides who will personally oversee your journey.
              </p>

              <!-- Direct WhatsApp Box -->
              <div class="mt-space-lg p-space-lg bg-surface-container-low rounded-2xl border border-outline-variant/30 shadow-sm flex flex-col gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-xl bg-primary text-secondary-fixed flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">chat</span>
                  </div>
                  <div>
                    <span class="font-label-md text-[11px] uppercase tracking-wider text-secondary">Instant Direct Messaging</span>
                    <h3 class="font-label-lg text-label-lg text-primary font-bold">WhatsApp Michael &amp; Maria</h3>
                  </div>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant">
                  Have questions about our 2027 Nicaragua departure, language comfort, fitness levels, or family travel? Send us a quick WhatsApp text.
                </p>
                <a
                  href="https://wa.me/14437225210?text=Hello%20Michael%20and%20Maria!%20I%20am%20interested%20in%20the%202027%20Nicaragua%20tour%20or%20planning%20a%20trip%20with%20Mountains%20to%20Coast%20Travel."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 bg-secondary-fixed text-primary font-label-md text-label-md uppercase tracking-wider py-2.5 px-4 rounded-xl hover:bg-primary hover:text-on-primary transition-colors text-center font-bold"
                >
                  <span class="material-symbols-outlined text-[18px]">send</span>
                  <span>Open WhatsApp (+1 443-722-5210)</span>
                </a>
              </div>

              <!-- Direct Contact Details -->
              <div class="mt-space-md p-space-md bg-surface-container-low rounded-2xl border border-outline-variant/30 space-y-3">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[20px]">mail</span>
                  </div>
                  <div>
                    <span class="font-label-md text-[10px] uppercase tracking-wider text-secondary block font-bold">Email Address</span>
                    <a href="mailto:mheller@mountainstocoasttravel.com" class="font-body-md text-xs sm:text-sm font-bold text-primary hover:underline break-all">
                      mheller@mountainstocoasttravel.com
                    </a>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[20px]">call</span>
                  </div>
                  <div>
                    <span class="font-label-md text-[10px] uppercase tracking-wider text-secondary block font-bold">Direct Phone Line</span>
                    <a href="tel:+14437225210" class="font-body-md text-sm font-bold text-primary hover:underline">
                      +1 (443) 722-5210
                    </a>
                  </div>
                </div>
              </div>

              <!-- Social Media Follow -->
              <div class="mt-space-md p-space-md bg-surface-container-lowest rounded-2xl border border-outline-variant/30">
                <span class="font-label-md text-[11px] uppercase tracking-widest text-primary font-bold block mb-2.5">
                  Follow Our Journeys Online:
                </span>
                <div class="flex flex-col gap-2 font-body-md text-xs">
                  <a
                    href="https://www.facebook.com/share/1DtmuAkLDi/?mibextid=wwXIfr"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2.5 text-on-surface hover:text-primary transition-colors py-1 px-2 rounded-lg hover:bg-surface-container"
                  >
                    <svg class="w-4 h-4 fill-primary shrink-0" viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
                    <span>Facebook: Mountains to Coast Travel</span>
                  </a>
                  <a
                    href="https://www.instagram.com/mountainstocoasttravel?dlrf=N3p1M3NoazNkZTYx&utm_source=qr"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2.5 text-on-surface hover:text-primary transition-colors py-1 px-2 rounded-lg hover:bg-surface-container"
                  >
                    <svg class="w-4 h-4 fill-primary shrink-0" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    <span>Instagram: @mountainstocoasttravel</span>
                  </a>
                  <a
                    href="https://youtube.com/@mariapadillah?si=ex-xcToOotZvk__q"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2.5 text-on-surface hover:text-primary transition-colors py-1 px-2 rounded-lg hover:bg-surface-container"
                  >
                    <svg class="w-4 h-4 fill-primary shrink-0" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                    <span>YouTube: @mariapadillah</span>
                  </a>
                  <a
                    href="https://www.tiktok.com/@mountaintocoasttravel?_r=1&_t=ZT-9AsityZTDQ5"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2.5 text-on-surface hover:text-primary transition-colors py-1 px-2 rounded-lg hover:bg-surface-container"
                  >
                    <svg class="w-4 h-4 fill-primary shrink-0" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                    <span>TikTok: @mountaintocoasttravel</span>
                  </a>
                </div>
              </div>

              <!-- Peace of Mind Guarantees -->
              <div class="mt-space-md space-y-2 text-secondary font-caption text-caption">
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-primary">verified</span>
                  <span>100% deposit refund if minimum tour participants are not reached.</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-primary">translate</span>
                  <span>Bilingual support in fluent Spanish &amp; English.</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-primary">lock</span>
                  <span>Your personal contact information is never shared or sold.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Interactive Booking Form (7 cols) -->
          <div class="lg:col-span-7 bg-surface-container-lowest p-space-lg md:p-space-xl rounded-3xl border border-outline-variant/40 shadow-sm scroll-reveal-right">
            <div class="flex flex-col gap-1 mb-space-md pb-space-sm border-b border-surface-container-highest">
              <span class="font-label-md text-label-md uppercase tracking-widest text-on-tertiary-container font-semibold">Trip Reservation &amp; Inquiry</span>
              <h2 class="font-headline-sm text-headline-sm text-primary">Tell Us About Your Desired Journey</h2>
              <p class="font-body-md text-body-md text-on-surface-variant">
                Whether joining an upcoming public group tour or crafting a custom trip for 5+ family and friends, fill out the details below:
              </p>
            </div>

            <form id="standalone-inquiry-form" class="space-y-space-md">
              
              <!-- Name & Email -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div class="flex flex-col gap-1">
                  <label for="form-name" class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                    Full Name *
                  </label>
                  <input
                    id="form-name"
                    name="name"
                    type="text"
                    required
                    placeholder="e.g. David Ramirez"
                    class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors"
                  />
                </div>

                <div class="flex flex-col gap-1">
                  <label for="form-email" class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                    Email Address *
                  </label>
                  <input
                    id="form-email"
                    name="email"
                    type="email"
                    required
                    placeholder="david@example.com"
                    class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors"
                  />
                </div>
              </div>

              <!-- Phone & Traveler Count -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div class="flex flex-col gap-1">
                  <label for="form-phone" class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                    Phone or WhatsApp (Optional)
                  </label>
                  <input
                    id="form-phone"
                    name="phone"
                    type="tel"
                    placeholder="+1 (555) 234-5678"
                    class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors"
                  />
                </div>

                <div class="flex flex-col gap-1">
                  <label for="form-guests" class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                    Number of Travelers
                  </label>
                  <select
                    id="form-guests"
                    name="guests"
                    class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors cursor-pointer"
                  >
                    <option value="1">Solo Traveler (1 Guest)</option>
                    <option value="2" selected>Couple / Pair (2 Guests)</option>
                    <option value="3-4">Small Party (3 – 4 Guests)</option>
                    <option value="5+">Family / Friend Group (5+ Guests • Custom Route)</option>
                    <option value="larger">Large Private Group (8+ Guests)</option>
                  </select>
                </div>
              </div>

              <!-- Destination & Travel Format -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div class="flex flex-col gap-1">
                  <label for="form-destination" class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                    Destination of Interest
                  </label>
                  <select
                    id="form-destination"
                    name="destination"
                    class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors cursor-pointer"
                  >
                    <option value="nicaragua" selected>Nicaragua: Nature is Waiting (Feb 28 – Mar 7, 2027 • Reservations Open)</option>
                    <option value="costa-rica">Costa Rica (Date Not Planned • Custom 5+)</option>
                    <option value="guatemala">Guatemala &amp; Lake Atitlán (Date Not Planned • Custom 5+)</option>
                    <option value="honduras">Honduras (Date Not Planned • Custom 5+)</option>
                    <option value="el-salvador">El Salvador (Date Not Planned • Custom 5+)</option>
                    <option value="peru">Peru: Sacred Valley &amp; Machu Picchu (Date Not Planned • Custom 5+)</option>
                    <option value="recommend">Not Sure • Recommend Based on Interests</option>
                  </select>
                </div>

                <div class="flex flex-col gap-1">
                  <label for="form-type" class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                    Trip Format
                  </label>
                  <select
                    id="form-type"
                    name="type"
                    class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors cursor-pointer"
                  >
                    <option value="public-group" selected>Scheduled Public Group Tour (Nicaragua 2027)</option>
                    <option value="family-friends">Family &amp; Friends Custom Group (5+ Guests)</option>
                    <option value="private-couple">Private Couple / Small Party (Custom Dates)</option>
                    <option value="bespoke">Bespoke Latin America Route</option>
                  </select>
                </div>
              </div>

              <!-- Target Window -->
              <div class="flex flex-col gap-1">
                <label for="form-timeframe" class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                  Preferred Travel Window / Season
                </label>
                <select
                  id="form-timeframe"
                  name="timeframe"
                  class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors cursor-pointer"
                >
                  <option value="nicaragua-2027" selected>Feb 28 – Mar 7, 2027 (Nicaragua Group Tour • Confirmed)</option>
                  <option value="spring-2027">Spring 2027 (Custom Dates • 5+ Guests)</option>
                  <option value="summer-fall-2027">Summer / Fall 2027 (Custom Dates • 5+ Guests)</option>
                  <option value="winter-2027-2028">Late 2027 / Early 2028 (Custom Dates • 5+ Guests)</option>
                  <option value="flexible">Flexible / Any Optimal Season</option>
                </select>
              </div>

              <!-- Message / Notes -->
              <div class="flex flex-col gap-1">
                <label for="form-notes" class="font-label-md text-label-md uppercase tracking-wider text-secondary font-semibold">
                  Special Wishes, Interests, or Questions
                </label>
                <textarea
                  id="form-notes"
                  name="notes"
                  rows="4"
                  placeholder="Tell us about what you love: hiking, quiet beach time, local food, coffee, history, wildlife photography, or any language/custom questions you have."
                  class="w-full bg-surface-container-low px-space-md py-space-sm font-body-md text-body-md text-on-surface rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary focus:bg-surface-bright transition-colors"
                ></textarea>
              </div>

              <!-- Submit Button -->
              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full bg-primary-container text-on-primary py-space-md px-space-lg rounded-xl font-label-lg text-label-lg uppercase tracking-widest hover:bg-primary transition-all flex items-center justify-center gap-space-xs shadow-md cursor-pointer"
                >
                  <span>Send Trip Inquiry</span>
                  <span class="material-symbols-outlined text-[18px]">send</span>
                </button>
              </div>

              <!-- Success Alert -->
              <div
                id="standalone-form-success"
                class="hidden p-space-md bg-secondary-fixed text-primary rounded-xl border border-secondary text-center font-body-md text-[14px]"
              >
                <span class="material-symbols-outlined text-[20px] align-middle mr-1 text-primary">check_circle</span>
                <strong>Thank you!</strong> Your trip inquiry has been sent to Michael and Maria. We will review your dates and travel preferences and reply within 24 hours.
              </div>

            </form>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  // Handle URL query parameters to auto-select tour or trip type
  const urlParams = new URLSearchParams(window.location.search);
  const tourParam = urlParams.get('tour');
  const typeParam = urlParams.get('type');

  if (tourParam) {
    const destSelect = document.getElementById('form-destination') as HTMLSelectElement | null;
    if (destSelect) {
      if (tourParam.includes('costa-rica')) destSelect.value = 'costa-rica';
      else if (tourParam.includes('guatemala')) destSelect.value = 'guatemala';
      else if (tourParam.includes('nicaragua')) destSelect.value = 'nicaragua';
      else if (tourParam.includes('panama')) destSelect.value = 'panama';
      else if (tourParam.includes('honduras')) destSelect.value = 'honduras-salvador';
    }
  }

  if (typeParam === 'family-friends') {
    const typeSelect = document.getElementById('form-type') as HTMLSelectElement | null;
    const guestsSelect = document.getElementById('form-guests') as HTMLSelectElement | null;
    if (typeSelect) typeSelect.value = 'family-friends';
    if (guestsSelect) guestsSelect.value = '5+';
  }

  // Form submission handling
  const form = document.getElementById('standalone-inquiry-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('standalone-form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (successBanner) {
      successBanner.classList.remove('hidden');
      form.reset();
      successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
</script>
